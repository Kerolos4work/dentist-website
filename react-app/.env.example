# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback if a publishable key is not available
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clinic Workspace domain used to restrict staff dashboards
NEXT_PUBLIC_CLINIC_DOMAIN=

# Canonical site URL for OAuth redirects and payment return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Edge Function secrets (set with `supabase secrets set`)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
FAWRY_MERCHANT_CODE=
FAWRY_SECRET_KEY=
FAWRY_HMAC_SECRET=
SITE_URL=http://localhost:3000
